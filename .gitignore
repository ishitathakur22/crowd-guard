# ==============================================================================
# Crowd Guard .gitignore
# ==============================================================================

# --- Python Bytecode & Caches -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/

# --- Virtual Environments & Env Files -----------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
.env
.env.*

# --- Build & Packaging --------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# --- AI / Model Weights & Large Binaries --------------------------------------
weights/
*.pt
*.pth
*.onnx
*.bin
*.gguf
*.ggml
*.safetensors

# --- Local Data, Coverage & Generated Output ----------------------------------
*.sqlite3
*.db
autopilot_log.jsonl
*.jsonl
coverage.xml
.htmlcov/

# --- Local Runtime Artifacts, Logs & Temp Files -------------------------------
backend/.cache/
frontend/.cache/
*.log
*.tmp
*.temp

# --- Jupyter Notebooks --------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / Editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS Files -----------------------------------------------------------------
Thumbs.db
.DS_Store
Desktop.ini
