# ==============================================================================
# Crowd Guard .gitignore
# ==============================================================================

# --- Python Bytecode & Caches -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# --- Virtual Environments & Env Files -----------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
.env
.env.*

# --- Build & Packaging --------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# --- AI / Model Weights & Large Binaries --------------------------------------
weights/
*.pt
*.pth
*.onnx
*.bin
*.gguf
*.ggml
*.safetensors

# --- Local Data, Coverage & Generated Output ----------------------------------
*.sqlite3
*.db
autopilot_log.jsonl
backend/data/autopilot_log.jsonl
*.jsonl
coverage.xml
.coverage
.coverage.*
htmlcov/
.htmlcov/
*.prof
*.lprof

# --- Measurement Artefacts ----------------------------------------------------
# Regenerated on demand by scripts/bench.py, scripts/record_trajectory.py,
# scripts/record_hotspot.py, scripts/eval_forecast.py and
# scripts/eval_reliability.py.
#
# benchmarks/README.md is tracked: it is the written record of what the numbers
# were, which changes were reverted and why, and how to rebuild every figure.
# The JSON summaries and .npz trajectories beside it are outputs, not sources.
benchmarks/*.json
benchmarks/*.npz

# --- Local Runtime Artifacts, Logs & Temp Files -------------------------------
backend/.cache/
frontend/.cache/
runs/
*.log
*.tmp
*.temp

# --- Jupyter Notebooks --------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / Editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS Files -----------------------------------------------------------------
Thumbs.db
.DS_Store
Desktop.ini
